# Reference form of the explicit rules injected into the 3448 monolithic policy.
# The executable, helper, init socket and private data share this one dedicated
# type because the old policy library cannot safely append more types later.
type r1_update_supervisor;

allow init r1_update_supervisor:process { transition rlimitinh siginh noatsecure };
allow r1_update_supervisor self:file { entrypoint open read execute getattr create write setattr rename unlink };
allow init r1_update_supervisor:unix_stream_socket { create bind listen setopt getattr };
allow init r1_update_supervisor:sock_file { create open write getattr setattr unlink };
allow init r1_update_supervisor:dir { create open read search getattr setattr relabelto };
allow r1_update_supervisor init:fd use;
allow r1_update_supervisor kernel:fd use;
allow r1_update_supervisor init:process sigchld;
allow r1_update_supervisor self:process { fork sigchld };

allow r1_update_supervisor rootfs:dir { open read search getattr };
allow r1_update_supervisor rootfs:file { entrypoint open read execute getattr };
allow r1_update_supervisor rootfs:lnk_file { read getattr };
allow r1_update_supervisor labeledfs:filesystem associate;
allow r1_update_supervisor tmpfs:filesystem associate;
allow r1_update_supervisor device:dir { search getattr };
allow r1_update_supervisor socket_device:dir search;
allow r1_update_supervisor system_file:dir { open read search getattr };
allow r1_update_supervisor system_file:file { open read execute execute_no_trans getattr };
allow r1_update_supervisor system_file:lnk_file { read getattr };
allow r1_update_supervisor zygote_exec:file { open read execute execute_no_trans getattr };
allow r1_update_supervisor proc:dir { open read search getattr };
allow r1_update_supervisor proc:file { open read getattr };
allow r1_update_supervisor properties_device:file { open read getattr };
allow r1_update_supervisor null_device:chr_file { open read write getattr ioctl };

# Read-only package identity needs PackageManager Binder and APK/dalvik inputs.
# Package replacement uses the same fixed PackageManager Binder service; no
# block-device, mount, network or arbitrary shell permission is granted.
allow r1_update_supervisor binder_device:chr_file { open read write getattr ioctl };
allow r1_update_supervisor system_server_service:service_manager find;
allow r1_update_supervisor system_server:binder { call transfer };
allow system_server r1_update_supervisor:binder { call transfer };
allow r1_update_supervisor system_data_file:dir { open read search getattr };
allow r1_update_supervisor apk_data_file:dir { open read search getattr };
allow r1_update_supervisor apk_data_file:file { open read getattr };
allow r1_update_supervisor dalvikcache_data_file:dir { open read write search add_name getattr };
allow r1_update_supervisor dalvikcache_data_file:file { create open read write getattr setattr };

allow r1_update_supervisor self:dir { create open read write search add_name remove_name getattr setattr };
allow r1_update_supervisor self:sock_file { open read write getattr };
allow r1_update_supervisor self:unix_stream_socket { listen accept read write getattr getopt setopt shutdown };
allow untrusted_app r1_update_supervisor:sock_file { open read write getattr };
allow untrusted_app r1_update_supervisor:unix_stream_socket connectto;
allow r1_update_supervisor untrusted_app:unix_stream_socket { accept read write getattr getopt setopt };

allow r1_update_supervisor self:unix_dgram_socket { create connect write };
allow r1_update_supervisor logdw_socket:sock_file { open write getattr };
allow r1_update_supervisor logd:unix_dgram_socket sendto;
