# This file is a boot-ramdisk template for r1-sample01 only. Deployment tooling must
# verify the package UID is still 10010 and substitute the final library/output shape.
service r1_factory_audio /sbin/r1-factory-audio-agent \
    --expected-uid 10010 --drop-uid 1041 --drop-gid 1041 \
    --vendor-library /system/lib/libuni4michal.so \
    --vendor-open-channels 2 --vendor-output-channels @PROVEN_OUTPUT_CHANNELS@ \
    --vendor-output-channel @PROVEN_OUTPUT_CHANNEL@
    class main
    user root
    group root
    seclabel u:r:r1_factory_audio:s0
    disabled

# Start only after the deployment gate has verified package UID, vendor hashes and
# the proven output layout. The normal boot image must not contain unsubstituted tokens.
on property:sys.boot_completed=1
    start r1_factory_audio
