local-deps/
local-models/

# One-shot local native credentials (never commit)
.r1_native_commission.json
*.psk

# Local bounded diagnostic recordings and exports
test-results/**/*.r1diag

# Public repository: raw evidence stays on the home workstation.
/test-results/*
!/test-results/README.md
!/test-results/public/
/test-results/public/*
!/test-results/public/index.json
!/test-results/public/structured.json
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.r1diag
*.aar
*.so
*.tflite
*.onnx
*.zip
*.tar
*.gz
