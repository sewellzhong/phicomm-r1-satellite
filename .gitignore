# Android/Gradle build state
.gradle/
**/.gradle/
**/build/
**/__pycache__/
*.pyc
local.properties
**/local.properties

# Local Android SDKs and signing material
.android-sdk/
*.jks
*.keystore

# Temporary probe packages and device-side diagnostic audio
*.apk
test-results/**/*.wav
test-results/**/*.pcm

